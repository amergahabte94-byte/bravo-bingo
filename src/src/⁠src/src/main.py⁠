def send_message(chat_id, text):
    import requests
    url = f"{TELEGRAM_INIT_URL}/sendMessage"
    payload = {
        "chat_id": chat_id,
        "text": text,
        "parse_mode": "Markdown"
    }
    requests.post(url, json=payload)

def send_main_menu(chat_id, text):
    import requests
    url = f"{TELEGRAM_INIT_URL}/sendMessage"
    keyboard = [
        ["🎮 ፕሌይ ቢንጎ (Boards 1-200)", "💰 ቼክ ባላንስ"],
        ["📥 ዲፖዚት (Deposit)", "📤 ዊዝድሮ (Withdraw)"],
        ["📞 ኮንታክት አስ (Contact Us)"]
    ]
    payload = {
        "chat_id": chat_id,
        "text": text,
        "parse_mode": "HTML",
        "reply_markup": {
            "keyboard": keyboard,
            "resize_keyboard": True
        }
    }
    requests.post(url, json=payload)

def send_inline_banks(chat_id, text, prefix):
    import requests
    url = f"{TELEGRAM_INIT_URL}/sendMessage"
    payload = {
        "chat_id": chat_id,
        "text": text,
        "parse_mode": "HTML",
        "reply_markup": {
            "inline_keyboard": [
                [{"text": "🏦 ንግድ ባንክ (CBE - እንያቸው አማርጋ)", "callback_data": f"{prefix}_CBE"}],
                [{"text": "📱 ቴሌብር (Telebirr - እንያቸው አማርጋ)", "callback_data": f"{prefix}_TELEBIRR"}]
            ]
        }
    }
    requests.post(url, json=payload)

